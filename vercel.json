{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "/api/auth-proxy?path=/__/auth/:path*" },
    { "source": "/__/firebase/init.json", "destination": "/api/auth-proxy?path=/__/firebase/init.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()" }
      ]
    }
  ]
}
