# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Optional: Firebase App Check (reCAPTCHA v3 site key). See README "App Check".
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# Optional: family push notifications. Generate the pair with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=

# App URL
VITE_APP_URL=http://localhost:3000

# ---- Server side (Vercel project settings, not the browser) ----
# Service account JSON used by the Alexa endpoint
# FIREBASE_SERVICE_ACCOUNT=
# Recommended: lets the Alexa endpoint read the request body byte for byte to check its signature
# NODEJS_HELPERS=0
# Optional: only accept requests addressed to this skill id (amzn1.ask.skill....)
# ALEXA_SKILL_ID=
# Temporary escape hatch: "log" = report invalid Alexa signatures without rejecting them
# ALEXA_SIGNATURE_MODE=enforce
# Family push notifications (the public key is VITE_VAPID_PUBLIC_KEY above)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Only if the app uses a named Firestore database: the same value as VITE_FIREBASE_FIRESTORE_DATABASE_ID
# FIRESTORE_DATABASE_ID=
# Only if LibreLinkUp starts rejecting the app version the bridge sends
# LIBRE_LLU_VERSION=4.16.0
